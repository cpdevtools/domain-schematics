{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "projects": {
    "<%= fileName %>": {
      "projectType": "library",
      "root": "",
      "sourceRoot": ".",
      "prefix": "<%= prefix %>",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "ng-package.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": "<%= fileName %>:build"
          }
        }
      }
    }
  }
}

{
  "name": "@cpdevtools/domain-schematics-workspace",
  "version": "0.0.0-MAIN",
  "private": true,
  "description": "Angular schematics for domain packages \u2014 workspace root",
  "scripts": {
    "build": "devutil run build",
    "check": "wireit",
    "clean": "wireit",
    "fix": "wireit",
    "format": "wireit",
    "gitflow": "gitflow",
    "lint": "devutil run lint",
    "postinstall": "devutil dev-link auto",
    "prepare": "husky || true",
    "reset": "wireit",
    "test": "devutil run test",
    "typecheck": "devutil run typecheck"
  },
  "devDependencies": {
    "@cpdevtools/git-flow": "^1.3.0",
    "@cpdevtools/git-flow-cli": "^1.3.0",
    "@cpdevtools/ts-dev-utilities-cli": "^1.2.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "syncpack": "^13.0.0",
    "typescript": "~6.0.2",
    "wireit": "^0.14.13",
    "typescript-eslint": "^8.69.0",
    "@eslint/js": "^9.18.0"
  },
  "keywords": [],
  "author": "CPDevTools",
  "license": "MIT",
  "repository": "cpdevtools/domain-schematics.git",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0",
  "wireit": {
    "fix": {
      "dependencies": [
        "fix.syncpack",
        "fix.git-remove-tags",
        "format"
      ]
    },
    "fix.deps": {
      "command": "devutil dep-versions fix .publish/deps.yml"
    },
    "fix.git-remove-tags": {
      "command": "git tag | xargs -r git tag -d"
    },
    "fix.syncpack": {
      "command": "syncpack fix-mismatches",
      "dependencies": [
        "fix.deps"
      ]
    },
    "format": {
      "dependencies": [
        "format.prettier",
        "format.projects"
      ]
    },
    "format.syncpack": {
      "command": "syncpack format"
    },
    "format.prettier": {
      "command": "prettier --write \"**/*.{ts,js,json,md,yml}\" --ignore-path .gitignore",
      "dependencies": [
        "format.syncpack"
      ]
    },
    "format.projects": {
      "command": "devutil run format"
    },
    "check": {
      "dependencies": [
        "check.deps",
        "check.syncpack"
      ]
    },
    "check.deps": {
      "command": "devutil dep-versions check .publish/deps.yml"
    },
    "check.syncpack": {
      "command": "syncpack list-mismatches"
    },
    "clean": {
      "dependencies": [
        "clean.install"
      ]
    },
    "clean.git": {
      "command": "git clean -dfX",
      "cache": false
    },
    "clean.install": {
      "command": "pnpm install",
      "dependencies": [
        "clean.git"
      ],
      "cache": false
    },
    "reset": {
      "dependencies": [
        "reset.git",
        "pnpm.install"
      ]
    },
    "reset.git": {
      "command": "git reset --hard",
      "cache": false
    },
    "pnpm.install": {
      "command": "pnpm install",
      "cache": false
    }
  }
}
